        private int y;

        public Position(int x, int y) {
            this.x = x;
            this.y = y;
        }

        public int getX() {
            return x;
        }

        public int getY() {
            return y;
        }
    }

    // Weapon class for managing player weapons
    public static class Weapon {
        private String name;
        private int damage;
        private int ammo;

        public Weapon(String name, int damage, int ammo) {
            this.name = name;
            this.damage = damage;
            this.ammo = ammo;
        }

        public String getName() {
            return name;
        }

        public int getDamage() {
            return damage;
        }

        public int getAmmo() {
            return ammo;
        }

        public void use() {
            if (ammo > 0) ammo--;
        }
    }

    // Vehicle class for managing player vehicles
    public static class Vehicle {
        private String type;
        private int speed;
        private int health;

        public Vehicle(String type, int speed, int health) {
            this.type = type;
            this.speed = speed;
            this.health = health;
        }

        public String getType() {
            return type;
        }

        public int getSpeed() {
            return speed;
        }

        public int getHealth() {
            return health;
        }
    }

    // Shop class for in-game purchases
    public static class Shop {
        public void displayItems() {
            System.out.println("Shop: Weapons, Vehicles");
        }

        public boolean buyWeapon(Player player, Weapon weapon, int cost) {
            if (player.spendCoins(cost)) {
                player.addWeapon(weapon);
                return true;
            }
            return false;
        }
    }

